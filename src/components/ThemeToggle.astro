---
/**
 * Theme switch. Renders both glyphs and lets CSS pick by the root data-theme
 * attribute, so the correct icon is present in the very first paint — no
 * post-hydration swap, no flash.
 */
---

<button
  type="button"
  data-theme-toggle
  aria-pressed="false"
  class="flex h-9 w-9 items-center justify-center rounded-sm text-ink-muted transition-colors duration-200 hover:text-ink"
>
  <span class="sr-only">Toggle dark mode</span>

  <svg
    class="block dark:hidden"
    width="15"
    height="15"
    viewBox="0 0 15 15"
    fill="none"
    aria-hidden="true"
    stroke="currentColor"
    stroke-width="1.2"
    stroke-linecap="round"
  >
    <circle cx="7.5" cy="7.5" r="3.1" />
    <path d="M7.5 0.8v1.8M7.5 12.4v1.8M0.8 7.5h1.8M12.4 7.5h1.8M2.76 2.76l1.27 1.27M10.97 10.97l1.27 1.27M12.24 2.76l-1.27 1.27M4.03 10.97l-1.27 1.27" />
  </svg>

  <svg
    class="hidden dark:block"
    width="15"
    height="15"
    viewBox="0 0 15 15"
    fill="none"
    aria-hidden="true"
    stroke="currentColor"
    stroke-width="1.2"
    stroke-linejoin="round"
  >
    <path d="M13 9.4A6 6 0 0 1 5.6 2a6.2 6.2 0 1 0 7.4 7.4Z" />
  </svg>
</button>
