---
import { site, navigation } from "~/data/site";
import ThemeToggle from "~/components/ThemeToggle.astro";
import { resumeAvailable, resumeHref, resumeLabel } from "~/lib/resume";

const isHome = Astro.url.pathname === "/";
---

<header
  class="sticky top-0 z-50 border-b border-rule/70 bg-paper/80 backdrop-blur-md supports-[backdrop-filter]:bg-paper/65"
>
  <div class="shell flex h-14 items-center justify-between gap-4 md:h-16">
    <a
      href="/"
      class="group flex items-baseline gap-2.5 rounded-sm focus-visible:outline-2"
      aria-label={isHome ? `${site.name} — home` : `${site.name} — back to home`}
    >
      <span class="text-[0.9375rem] font-medium tracking-tight text-ink">
        {site.name}
      </span>
      <span class="label hidden sm:inline">CSE · BRACU</span>
    </a>

    <div class="flex items-center gap-1 md:gap-2">
      <nav aria-label="Sections" class="hidden md:block">
        <ul class="flex items-center gap-1">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-nav-link={item.href.replace("/#", "")}
                  class="group flex items-center gap-1.5 rounded-sm px-2.5 py-2 text-[0.8125rem] text-ink-muted transition-colors duration-200 hover:text-ink aria-[current=true]:text-ink"
                >
                  <span class="font-mono text-[0.625rem] text-ink-faint transition-colors duration-200 group-hover:text-accent-ink group-aria-[current=true]:text-accent-ink">
                    {item.index}
                  </span>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="hidden h-4 w-px bg-rule md:block" aria-hidden="true"></div>

      <ThemeToggle />

      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="-mr-2 flex h-10 w-10 items-center justify-center rounded-sm text-ink md:hidden"
      >
        <span class="sr-only">Menu</span>
        <svg
          width="18"
          height="12"
          viewBox="0 0 18 12"
          fill="none"
          aria-hidden="true"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M0 1h18M0 11h18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <div
    id="mobile-nav"
    data-nav-panel
    data-open="false"
    class="fixed inset-x-0 top-14 bottom-0 z-40 hidden flex-col bg-paper data-[open=true]:flex md:!hidden"
  >
    <nav aria-label="Sections" class="shell flex-1 overflow-y-auto py-8">
      <ul class="flex flex-col">
        {
          navigation.map((item) => (
            <li class="border-b border-rule">
              <a
                href={item.href}
                data-nav-link={item.href.replace("/#", "")}
                class="flex items-baseline gap-4 py-5 text-2xl tracking-tight text-ink aria-[current=true]:text-accent-ink"
              >
                <span class="font-mono text-[0.6875rem] text-ink-faint">{item.index}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-col gap-3">
        <a href={resumeHref} class="label text-ink-muted hover:text-accent-ink">
          {resumeLabel} {resumeAvailable ? "↓" : "↗"}
        </a>
        <a href={site.links.github} class="label text-ink-muted hover:text-accent-ink">
          GitHub ↗
        </a>
        <a href={site.links.linkedin} class="label text-ink-muted hover:text-accent-ink">
          LinkedIn ↗
        </a>
      </div>
    </nav>
  </div>
</header>
