---
import SectionHeader from "~/components/SectionHeader.astro";
import { education, coursework } from "~/data/education";
import Pending from "~/components/Pending.astro";
import { isPending } from "~/lib/pending";

const periodPending = isPending(education.period);
---

<section id="education" class="border-t border-rule py-[var(--spacing-section)]">
  <div class="shell">
    <SectionHeader index="05" label="Education" title="Where the foundations came from." />

    <div class="grid gap-x-12 gap-y-12 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <div class="border-t-2 border-ink pt-5">
          <h3 class="font-display text-title">{education.institution}</h3>
          <p class="mt-2 text-[0.9375rem] text-ink-muted">
            {education.degree} — {education.field}
          </p>

          <dl class="mt-6 flex flex-col gap-3">
            <div class="flex items-baseline justify-between gap-4 border-b border-rule pb-3">
              <dt class="label">Location</dt>
              <dd class="text-sm text-ink-muted">{education.location}</dd>
            </div>

            <div class="flex items-baseline justify-between gap-4 border-b border-rule pb-3">
              <dt class="label">Period</dt>
              <dd class="text-sm">
                {periodPending ? (
                  <Pending value={education.period} fallback="start – graduation year" />
                ) : (
                  <span class="tabular-nums text-ink-muted">{education.period}</span>
                )}
              </dd>
            </div>

            {
              education.cgpa && (
                <div class="flex items-baseline justify-between gap-4 border-b border-rule pb-3">
                  <dt class="label">CGPA</dt>
                  <dd class="text-sm tabular-nums text-ink-muted">{education.cgpa}</dd>
                </div>
              )
            }
          </dl>
        </div>
      </div>

      <div class="lg:col-span-7" data-reveal style="--reveal-delay:100ms">
        <p class="label mb-6">Relevant coursework</p>

        <div class="grid gap-x-8 gap-y-8 sm:grid-cols-3">
          {
            coursework.map((group) => (
              <div>
                <h4 class="border-b border-rule pb-2.5 text-[0.8125rem] font-medium text-ink">
                  {group.title}
                </h4>
                <ul class="mt-3.5 flex flex-col gap-2.5">
                  {group.courses.map((course) => (
                    <li>
                      <span class="block font-mono text-[0.6875rem] text-accent-ink">
                        {course.code}
                      </span>
                      <span class="block text-sm leading-snug text-ink-muted">
                        {course.name}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
