---
import { getCollection } from "astro:content";
import SectionHeader from "~/components/SectionHeader.astro";
import { stack } from "~/data/stack";

const projects = await getCollection("projects");
const titleBySlug = new Map(projects.map((p) => [p.id, p.data.title]));
---

<section id="stack" class="border-t border-rule py-[var(--spacing-section)]">
  <div class="shell">
    <SectionHeader
      index="04"
      label="Stack"
      title="Every tool here points at the project that proves it."
      lede="No proficiency bars. Hover or tap any entry to see where it was actually used — and follow the link to check."
    />

    <div class="grid gap-x-12 gap-y-12 md:grid-cols-2 xl:grid-cols-3">
      {
        stack.map((group) => (
          <section aria-labelledby={`stack-${group.id}`} data-reveal>
            <h3
              id={`stack-${group.id}`}
              class="border-b border-rule pb-3 text-[0.9375rem] font-medium tracking-tight text-ink"
            >
              {group.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-faint">{group.blurb}</p>

            <ul class="mt-5 flex flex-col gap-3.5">
              {group.tools.map((tool) => (
                <li>
                  <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                    <span class="font-mono text-[0.8125rem] text-ink">{tool.name}</span>
                    {tool.note && (
                      <span class="text-[0.6875rem] text-ink-faint">{tool.note}</span>
                    )}
                  </div>

                  {tool.usedIn.length > 0 && (
                    <ul class="mt-1 flex flex-wrap gap-x-2 gap-y-0.5">
                      {tool.usedIn.map((slug, i) => (
                        <li class="flex items-baseline">
                          {i > 0 && (
                            <span class="mr-2 text-[0.625rem] text-ink-faint" aria-hidden="true">
                              ·
                            </span>
                          )}
                          <a
                            href={`/work/${slug}`}
                            class="link-underline text-[0.6875rem] text-ink-muted hover:text-accent-ink"
                          >
                            {titleBySlug.get(slug) ?? slug}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>
