---
import SectionHeader from "~/components/SectionHeader.astro";
import Pending from "~/components/Pending.astro";
import { isPending } from "~/lib/pending";

/**
 * Not a biography. Three positions I can defend in an interview, each one
 * traceable to something on this site — which is the only reason a recruiter
 * should believe any of them.
 */
const positions = [
  {
    index: "i",
    claim: "A result is only as good as the split that produced it.",
    body: "My thesis telemetry model scored 99.86% on a random split. Re-run with held-out drivers it scored 93.3% — the first number was measuring the driver, not the engine. Finding that cost a week and was the most valuable week of the project.",
    href: "/work/engine-health-grading",
    hrefLabel: "Engine health grading",
  },
  {
    index: "ii",
    claim: "Build the measuring instrument before the thing you measure.",
    body: "In the ASD framework the bootstrap intervals, per-site breakdowns and calibration curves were written before any model was tuned. It meant disappointing results arrived legible instead of confusing, and no headline number could be reported without the evidence beside it.",
    href: "/work/asd-detection-framework",
    hrefLabel: "ASD detection framework",
  },
  {
    index: "iii",
    claim: "Reach for a model only where a model is actually needed.",
    body: "The gesture keyboard recognises hand poses with geometry rather than a classifier. No forward pass, sub-millisecond latency, and lighting robustness inherited instead of learned. Knowing where learning does not belong is part of knowing how to use it.",
    href: "/work/gesture-keyboard",
    hrefLabel: "Gesture keyboard",
  },
];

const currently = [
  "Finishing the multimodal engine-health thesis and its cross-driver evaluation",
  "Reading into calibration and uncertainty for ordinal classification",
  "TODO_CONFIRM — what else are you actively learning right now?",
];
---

<section id="approach" class="border-t border-rule py-[var(--spacing-section)]">
  <div class="shell">
    <SectionHeader
      index="03"
      label="Approach"
      title="How I work, and why you should believe it."
    />

    <div class="grid gap-x-12 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <ol class="flex flex-col gap-10">
          {
            positions.map((position) => (
              <li class="grid gap-4 sm:grid-cols-[2.5rem_1fr]" data-reveal>
                <span class="label pt-1.5 text-accent-ink">{position.index}</span>
                <div>
                  <h3 class="max-w-2xl text-balance font-display text-title">
                    {position.claim}
                  </h3>
                  <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-muted">
                    {position.body}
                  </p>
                  <a
                    href={position.href}
                    class="link-underline mt-3 inline-block text-sm font-medium text-ink"
                  >
                    {position.hrefLabel} <span aria-hidden="true">→</span>
                  </a>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <aside class="lg:col-span-4" data-reveal>
        <div class="rounded-sm border border-rule bg-paper-raised p-6">
          <p class="label mb-4">Currently</p>
          <ul class="flex flex-col gap-3">
            {
              currently.map((item) => (
                <li class="flex gap-2.5 text-sm leading-relaxed text-ink-muted">
                  {isPending(item) ? (
                    <Pending value={item} />
                  ) : (
                    <>
                      <span
                        class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent"
                        aria-hidden="true"
                      />
                      {item}
                    </>
                  )}
                </li>
              ))
            }
          </ul>

          <div class="mt-7 border-t border-rule pt-5">
            <p class="label mb-3">Direction</p>
            <p class="text-sm leading-relaxed text-ink-muted">
              Machine-learning engineering or applied research — the roles where
              somebody has to own whether the model actually works, not only
              whether it trains. Comfortable owning the full path from raw signal
              to a deployed interface.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
