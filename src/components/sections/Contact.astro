---
import { site } from "~/data/site";
import Button from "~/components/Button.astro";
import { resumeAvailable, resumeHref, resumeLabel } from "~/lib/resume";

const channels = [
  { label: "Email", value: site.email.primary, href: `mailto:${site.email.primary}` },
  { label: "GitHub", value: "tareqsujat-cmd", href: site.links.github, external: true },
  { label: "LinkedIn", value: "tareq-sujat", href: site.links.linkedin, external: true },
  { label: "ResearchGate", value: "Publication record", href: site.links.researchgate, external: true },
];
---

<section id="contact" class="relative border-t border-rule py-[var(--spacing-section)]">
  <div class="relative z-10 shell">
    <div class="grid gap-x-12 gap-y-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="section-marker label mb-8" data-reveal>
          <span class="text-accent-ink">06</span>
          <span>Contact</span>
        </p>

        <h2
          class="max-w-2xl text-balance font-display text-display"
          data-reveal
          style="--reveal-delay:60ms"
        >
          If you have a signal nobody has managed to read yet, I'd like to hear
          about it.
        </h2>

        <p
          class="mt-6 max-w-xl text-lede text-ink-muted"
          data-reveal
          style="--reveal-delay:140ms"
        >
          Open to machine-learning engineering, applied research and software roles —
          internships and new-grad positions alike. The fastest way to reach me is
          email; I answer everything.
        </p>

        <div
          class="mt-9 flex flex-wrap items-center gap-3"
          data-reveal
          style="--reveal-delay:220ms"
        >
          <Button href={`mailto:${site.email.primary}`} variant="primary">
            Email me
          </Button>
          <Button href={resumeHref} variant="secondary" download={resumeAvailable}>
            {resumeAvailable ? "Download résumé" : resumeLabel}
          </Button>
        </div>
      </div>

      <div class="lg:col-span-5 lg:pt-16" data-reveal style="--reveal-delay:180ms">
        <dl class="border-t border-rule">
          {
            channels.map((channel) => (
              <div class="flex items-baseline justify-between gap-6 border-b border-rule py-4">
                <dt class="label">{channel.label}</dt>
                <dd class="min-w-0 text-right">
                  <a
                    href={channel.href}
                    class="link-underline truncate text-sm text-ink hover:text-accent-ink"
                    {...channel.external ? { rel: "noopener", target: "_blank" } : {}}
                  >
                    {channel.value}
                    {channel.external && <span aria-hidden="true"> ↗</span>}
                    {channel.external && <span class="sr-only">(opens in a new tab)</span>}
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
